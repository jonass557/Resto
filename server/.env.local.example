# === Configuration pour le serveur local d'impression ===
# Copiez ce fichier en .env et remplissez les valeurs

# MongoDB — utilisez la MÊME base que Render pour partager les données
MONGODB_URI=mongodb+srv://VOTRE_USER:VOTRE_PASS@cluster.mongodb.net/restaurant?retryWrites=true&w=majority

# JWT — utilisez la MÊME clé que sur Render pour que les tokens fonctionnent
JWT_SECRET=VOTRE_JWT_SECRET_IDENTIQUE_A_RENDER

# Port du serveur local
PORT=5000

# URL du client (pour CORS) — ajoutez l'URL Render ET localhost
CLIENT_URL=https://votre-frontend.vercel.app,http://localhost:5173

# Mode
NODE_ENV=production
